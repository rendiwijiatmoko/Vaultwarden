    "Use at least 12 characters. This password cannot be recovered." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم 12 حرفًا على الأقل. لا يمكن استرداد كلمة المرور هذه."
