    "Changes are encrypted on this device, saved to Vaultwarden, then synced back." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُشفّر التغييرات على هذا الجهاز وتُحفظ في Vaultwarden ثم تتم مزامنتها مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Промените се шифроват на това устройство, запазват се във Vaultwarden и след това се синхронизират обратно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিবর্তনগুলো এই ডিভাইসে এনক্রিপ্ট করে Vaultwarden-এ সংরক্ষণ করা হয়, তারপর আবার সিঙ্ক করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els canvis es xifren en aquest dispositiu, es desen a Vaultwarden i després es tornen a sincronitzar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změny jsou v tomto zařízení zašifrovány, uloženy do Vaultwardenu a poté synchronizovány zpět."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændringer krypteres på denne enhed, gemmes i Vaultwarden og synkroniseres derefter tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen werden auf diesem Gerät verschlüsselt, in Vaultwarden gespeichert und anschließend zurücksynchronisiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλαγές κρυπτογραφούνται σε αυτή τη συσκευή, αποθηκεύονται στο Vaultwarden και στη συνέχεια συγχρονίζονται ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes are encrypted on this device, saved to Vaultwarden, then synced back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se cifran en este dispositivo, se guardan en Vaultwarden y después se sincronizan de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغییرات در این دستگاه رمزگذاری، در Vaultwarden ذخیره و سپس دوباره همگام‌سازی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muutokset salataan tässä laitteessa, tallennetaan Vaultwardeniin ja synkronoidaan sitten takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications sont chiffrées sur cet appareil, enregistrées dans Vaultwarden, puis resynchronisées."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השינויים מוצפנים במכשיר זה, נשמרים ב-Vaultwarden ולאחר מכן מסונכרנים בחזרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलाव इस डिवाइस पर एन्क्रिप्ट किए जाते हैं, Vaultwarden में सहेजे जाते हैं और फिर वापस सिंक होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjene se šifriraju na ovom uređaju, spremaju u Vaultwarden i zatim ponovno sinkroniziraju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A módosítások ezen az eszközön titkosítódnak, a Vaultwardenbe mentődnek, majd visszaszinkronizálódnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan dienkripsi di perangkat ini, disimpan ke Vaultwarden, lalu disinkronkan kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche vengono crittografate su questo dispositivo, salvate in Vaultwarden e poi sincronizzate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更はこのデバイスで暗号化され、Vaultwardenに保存された後、同期されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзгерістер осы құрылғыда шифрланып, Vaultwarden жүйесіне сақталады, содан кейін қайта синхрондалады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항은 이 기기에서 암호화되어 Vaultwarden에 저장된 후 다시 동기화됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakeitimai šifruojami šiame įrenginyje, įrašomi į Vaultwarden ir tada sinchronizuojami."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan disulitkan pada peranti ini, disimpan ke Vaultwarden, kemudian disegerakkan kembali."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringer krypteres på denne enheten, lagres i Vaultwarden og synkroniseres deretter tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigingen worden op dit apparaat versleuteld, opgeslagen in Vaultwarden en daarna teruggesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany są szyfrowane na tym urządzeniu, zapisywane w Vaultwarden, a następnie synchronizowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações são encriptadas neste dispositivo, guardadas no Vaultwarden e depois sincronizadas novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificările sunt criptate pe acest dispozitiv, salvate în Vaultwarden, apoi sincronizate înapoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения шифруются на этом устройстве, сохраняются в Vaultwarden, а затем синхронизируются обратно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmeny sa v tomto zariadení zašifrujú, uložia do Vaultwarden a potom sa synchronizujú späť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremembe so šifrirane v tej napravi, shranjene v Vaultwarden in nato sinhronizirane nazaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändringar krypteras på den här enheten, sparas i Vaultwarden och synkroniseras sedan tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนแปลงจะถูกเข้ารหัสบนอุปกรณ์นี้ บันทึกไปยัง Vaultwarden แล้วซิงค์กลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişiklikler bu aygıtta şifrelenir, Vaultwarden'a kaydedilir ve ardından geri eşzamanlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зміни шифруються на цьому пристрої, зберігаються у Vaultwarden, а потім синхронізуються назад."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thay đổi được mã hóa trên thiết bị này, lưu vào Vaultwarden, rồi đồng bộ trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改会在此设备上加密，保存到 Vaultwarden，然后同步回来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改會在此裝置上加密，儲存到 Vaultwarden，然後同步回來。"
          }
        }
      }
    },
