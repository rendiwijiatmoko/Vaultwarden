    "Keep passwords, passkeys, verification codes, cards, and identities together in your own Vaultwarden server." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بكلمات المرور ومفاتيح المرور ورموز التحقق والبطاقات والهويات معًا على خادم Vaultwarden الخاص بك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Съхранявайте пароли, секретни ключове, кодове за потвърждение, карти и самоличности заедно на собствения си сървър на Vaultwarden."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাসওয়ার্ড, পাসকি, যাচাইকরণ কোড, কার্ড ও পরিচয় আপনার নিজের Vaultwarden সার্ভারে একসঙ্গে রাখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manteniu les contrasenyes, les claus de pas, els codis de verificació, les targetes i les identitats juntes al vostre propi servidor Vaultwarden."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uchovávejte hesla, přístupové klíče, ověřovací kódy, karty a identity pohromadě na vlastním serveru Vaultwarden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opbevar adgangskoder, adgangsnøgler, bekræftelseskoder, kort og identiteter samlet på din egen Vaultwarden-server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre Passwörter, Passkeys, Bestätigungscodes, Karten und Identitäten gemeinsam auf deinem eigenen Vaultwarden-Server auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρήστε κωδικούς, κλειδιά πρόσβασης, κωδικούς επαλήθευσης, κάρτες και ταυτότητες μαζί στον δικό σας διακομιστή Vaultwarden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep passwords, passkeys, verification codes, cards, and identities together in your own Vaultwarden server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén contraseñas, claves de acceso, códigos de verificación, tarjetas e identidades juntas en tu propio servidor Vaultwarden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلمه‌های عبور، کلیدهای عبور، کدهای تأیید، کارت‌ها و هویت‌ها را در سرور Vaultwarden خود نگه دارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä salasanat, pääsyavaimet, vahvistuskoodit, kortit ja henkilöllisyydet yhdessä omalla Vaultwarden-palvelimellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
