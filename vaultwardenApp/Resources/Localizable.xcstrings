    "Use passwords and verification codes in Safari and supported apps after enabling the Credential Provider Extension." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم كلمات المرور ورموز التحقق في Safari والتطبيقات المدعومة بعد تفعيل ملحق موفر بيانات الاعتماد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използвайте пароли и кодове за потвърждение в Safari и поддържаните приложения, след като включите разширението за доставчик на идентификационни данни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ক্রেডেনশিয়াল প্রদানকারী এক্সটেনশন চালু করার পর Safari ও সমর্থিত অ্যাপে পাসওয়ার্ড ও যাচাইকরণ কোড ব্যবহার করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitzeu contrasenyes i codis de verificació a Safari i a les aplicacions compatibles després d'activar l'extensió del proveïdor de credencials."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapnutí rozšíření poskytovatele přihlašovacích údajů používejte hesla a ověřovací kódy v Safari a podporovaných aplikacích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug adgangskoder og bekræftelseskoder i Safari og understøttede apps, når udvidelsen til loginoplysninger er aktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Passwörter und Bestätigungscodes in Safari und unterstützten Apps, nachdem du die Erweiterung für Zugangsdatenanbieter aktiviert hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε κωδικούς και κωδικούς επαλήθευσης στο Safari και σε υποστηριζόμενες εφαρμογές αφού ενεργοποιήσετε την επέκταση παρόχου διαπιστευτηρίων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use passwords and verification codes in Safari and supported apps after enabling the Credential Provider Extension."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa contraseñas y códigos de verificación en Safari y en aplicaciones compatibles después de activar la extensión de proveedor de credenciales."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از فعال کردن افزونه ارائه‌دهنده اطلاعات ورود، از کلمه‌های عبور و کدهای تأیید در Safari و برنامه‌های پشتیبانی‌شده استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
