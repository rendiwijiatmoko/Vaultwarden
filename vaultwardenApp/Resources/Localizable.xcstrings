    "Verify before passwords, passkeys, or codes leave the vault." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق قبل خروج كلمات المرور أو مفاتيح المرور أو الرموز من الخزنة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверявайте, преди пароли, секретни ключове или кодове да напуснат трезора."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাসওয়ার্ড, পাসকি বা কোড ভল্ট থেকে বের হওয়ার আগে যাচাই করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifiqueu abans que les contrasenyes, claus de pas o codis surtin de la caixa forta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověřte se předtím, než hesla, přístupové klíče nebo kódy opustí trezor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekræft, før adgangskoder, adgangsnøgler eller koder forlader boksen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe, bevor Passwörter, Passkeys oder Codes den Tresor verlassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαληθεύστε πριν οι κωδικοί, τα κλειδιά πρόσβασης ή οι κωδικοί επαλήθευσης φύγουν από την κρύπτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify before passwords, passkeys, or codes leave the vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica antes de que las contraseñas, las claves de acceso o los códigos salgan de la caja fuerte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از خروج کلمه‌های عبور، کلیدهای عبور یا کدها از گاوصندوق، تأیید کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvista ennen kuin salasanat, pääsyavaimet tai koodit poistuvat holvista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez avant que les mots de passe, les clés d’accès ou les codes ne quittent le coffre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאמת לפני שסיסמאות, מפתחות גישה או קודים יוצאים מהכספת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड, पासकी या कोड तिजोरी से बाहर जाने से पहले सत्यापित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potvrdi prije nego što lozinke, pristupni ključevi ili kodovi napuste trezor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenőrizze, mielőtt jelszavak, hozzáférési kulcsok vagy kódok elhagyják a széfet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifikasi sebelum kata sandi, passkey, atau kode keluar dari brankas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica prima che password, passkey o codici escano dalla cassaforte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワード、パスキー、コードを保管庫から取り出す前に確認します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Құпиясөздер, кіру кілттері немесе кодтар қоймадан шықпас бұрын растаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀번호, 패스키 또는 코드가 볼트를 벗어나기 전에 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patvirtinkite prieš slaptažodžiams, prieigos raktams ar kodams paliekant saugyklą."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sahkan sebelum kata laluan, kunci laluan atau kod meninggalkan peti besi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekreft før passord, passnøkler eller koder forlater hvelvet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieer voordat wachtwoorden, passkeys of codes de kluis verlaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zweryfikuj, zanim hasła, klucze dostępu lub kody opuszczą sejf."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique antes de as palavras-passe, chaves de acesso ou códigos saírem do cofre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificați înainte ca parolele, cheile de acces sau codurile să părăsească seiful."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните проверку, прежде чем пароли, ключи доступа или коды покинут хранилище."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overte sa predtým, než heslá, prístupové kľúče alebo kódy opustia trezor."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preverite, preden gesla, ključi za dostop ali kode zapustijo trezor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifiera innan lösenord, nycklar eller koder lämnar valvet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันก่อนที่รหัสผ่าน พาสคีย์ หรือรหัสจะออกจากตู้นิรภัย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolalar, geçiş anahtarları veya kodlar kasadan çıkmadan önce doğrulayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевіряйте перед тим, як паролі, ключі доступу або коди залишать сховище."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xác minh trước khi mật khẩu, mã khóa hoặc mã rời khỏi kho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在密码、通行密钥或验证码离开密码库前进行验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在密碼、密碼金鑰或驗證碼離開密碼庫前進行驗證。"
          }
        }
      }
    },
