    "After enabling Vaultwarden in Passwords & Codes, sync this app once so iOS can refresh domain suggestions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد تفعيل Vaultwarden في «كلمات المرور والرموز»، زامن هذا التطبيق مرة واحدة ليتمكن iOS من تحديث اقتراحات النطاقات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "След като включите Vaultwarden в „Пароли и кодове“, синхронизирайте приложението веднъж, за да може iOS да обнови предложенията за домейни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords & Codes-এ Vaultwarden চালু করার পর অ্যাপটি একবার সিঙ্ক করুন, যাতে iOS ডোমেইনের পরামর্শ হালনাগাদ করতে পারে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Després d'activar Vaultwarden a Contrasenyes i codis, sincronitzeu aquesta aplicació una vegada perquè iOS pugui actualitzar els suggeriments de dominis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapnutí Vaultwardenu v části Hesla a kódy tuto aplikaci jednou synchronizujte, aby systém iOS mohl aktualizovat návrhy domén."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har aktiveret Vaultwarden under Adgangskoder og koder, skal du synkronisere appen én gang, så iOS kan opdatere domæneforslag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdem du Vaultwarden unter „Passwörter und Codes“ aktiviert hast, synchronisiere diese App einmal, damit iOS die Domainvorschläge aktualisieren kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφού ενεργοποιήσετε το Vaultwarden στους Κωδικούς και κωδικούς επαλήθευσης, συγχρονίστε αυτή την εφαρμογή μία φορά ώστε το iOS να ανανεώσει τις προτάσεις τομέων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After enabling Vaultwarden in Passwords & Codes, sync this app once so iOS can refresh domain suggestions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de activar Vaultwarden en Contraseñas y códigos, sincroniza esta aplicación una vez para que iOS pueda actualizar las sugerencias de dominios."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پس از فعال کردن Vaultwarden در «کلمه‌های عبور و کدها»، برنامه را یک‌بار همگام‌سازی کنید تا iOS پیشنهادهای دامنه را تازه کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun olet ottanut Vaultwardenin käyttöön Salasanat ja koodit -kohdassa, synkronoi tämä sovellus kerran, jotta iOS voi päivittää toimialue-ehdotukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir activé Vaultwarden dans Mots de passe et codes, synchronisez cette application une fois afin qu’iOS puisse actualiser les suggestions de domaines."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לאחר הפעלת Vaultwarden תחת סיסמאות וקודים, יש לסנכרן את היישום פעם אחת כדי ש-iOS ירענן את הצעות הדומיינים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासवर्ड और कोड में Vaultwarden को सक्षम करने के बाद इस ऐप को एक बार सिंक करें, ताकि iOS डोमेन सुझाव रीफ़्रेश कर सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon što uključiš Vaultwarden u Lozinkama i kodovima, jednom sinkroniziraj aplikaciju kako bi iOS mogao osvježiti prijedloge domena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miután engedélyezte a Vaultwardent a Jelszavak és kódok között, szinkronizálja egyszer az alkalmazást, hogy az iOS frissíthesse a tartományjavaslatokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah mengaktifkan Vaultwarden di Kata Sandi & Kode, sinkronkan aplikasi ini sekali agar iOS dapat menyegarkan saran domain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver abilitato Vaultwarden in Password e codici, sincronizza una volta l'app affinché iOS aggiorni i suggerimenti dei domini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「パスワードとコード」でVaultwardenを有効にした後、このアプリを一度同期して、iOSのドメイン候補を更新してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden қолданбасын Құпиясөздер мен кодтар бөлімінде қосқаннан кейін iOS домен ұсыныстарын жаңартуы үшін қолданбаны бір рет синхрондаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호 및 코드에서 Vaultwarden을 활성화한 후 iOS가 도메인 제안을 갱신할 수 있도록 이 앱을 한 번 동기화하세요."
