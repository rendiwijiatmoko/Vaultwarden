        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvanmrežni podaci trezora, redovi promjena i indeks automatskog popunjavanja šifrirani su na uređaju. Ključevi se spremaju u iOS privjesak ključeva i nisu uključeni u izvoze."
          }
        },
        "hu" : {
