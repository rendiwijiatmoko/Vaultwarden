        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ সম্পন্ন হয়নি। বায়োমেট্রিক্স বা ডিভাইস পাসকোড ব্যবহার করে আবার চেষ্টা করুন, অথবা প্রধান পাসওয়ার্ড দিয়ে আনলক করুন।"
