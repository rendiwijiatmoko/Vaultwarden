    "You can finish setup now and enable AutoFill later from the app's Settings tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إكمال الإعداد الآن وتفعيل الملء التلقائي لاحقًا من علامة تبويب الإعدادات في التطبيق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можете да завършите настройката сега и да включите автоматичното попълване по-късно от раздела „Настройки“ на приложението."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি এখন সেটআপ সম্পন্ন করতে পারেন এবং পরে অ্যাপের সেটিংস ট্যাব থেকে অটোফিল চালু করতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podeu completar la configuració ara i activar l'emplenament automàtic més endavant des de la pestanya Configuració de l'aplicació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení můžete dokončit nyní a automatické vyplňování zapnout později na kartě Nastavení aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fuldføre opsætningen nu og aktivere Autofyld senere fra appens fane Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst die Einrichtung jetzt abschließen und das automatische Ausfüllen später über den Tab „Einstellungen“ der App aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορείτε να ολοκληρώσετε τώρα τη ρύθμιση και να ενεργοποιήσετε αργότερα την Αυτόματη συμπλήρωση από την καρτέλα Ρυθμίσεις της εφαρμογής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can finish setup now and enable AutoFill later from the app's Settings tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes finalizar la configuración ahora y activar Autocompletar más adelante desde la pestaña Ajustes de la aplicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌توانید اکنون راه‌اندازی را کامل و تکمیل خودکار را بعداً از زبانه تنظیمات برنامه فعال کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit viimeistellä määrityksen nyt ja ottaa automaattisen täytön käyttöön myöhemmin sovelluksen Asetukset-välilehdeltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez terminer la configuration maintenant et activer le remplissage automatique ultérieurement depuis l’onglet Paramètres de l’application."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לסיים את ההגדרה עכשיו ולהפעיל את המילוי האוטומטי מאוחר יותר מהכרטיסייה הגדרות ביישום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अभी सेटअप पूरा कर सकते हैं और बाद में ऐप की सेटिंग टैब से ऑटोफ़िल सक्षम कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sada možeš dovršiti postavljanje i kasnije uključiti automatsko popunjavanje na kartici Postavke aplikacije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most befejezheti a beállítást, az Automatikus kitöltést pedig később engedélyezheti az alkalmazás Beállítások lapján."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat menyelesaikan penyiapan sekarang dan mengaktifkan Isi Otomatis nanti dari tab Pengaturan aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi completare ora la configurazione e abilitare in seguito la Compilazione automatica dalla scheda Impostazioni dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ設定を完了し、後でアプリの「設定」タブから自動入力を有効にできます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Орнатуды қазір аяқтап, Автотолтыруды кейін қолданбаның Параметрлер қойындысынан қосуға болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 설정을 완료하고 나중에 앱의 설정 탭에서 자동 완성을 활성화할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galite baigti sąranką dabar, o Automatinį pildymą įjungti vėliau programos Nuostatų kortelėje."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda boleh menyelesaikan persediaan sekarang dan mendayakan Isi Auto kemudian daripada tab Tetapan aplikasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fullføre oppsettet nå og aktivere Autofyll senere fra appens Innstillinger-fane."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de configuratie nu voltooien en Automatisch invullen later inschakelen via het tabblad Instellingen van de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zakończyć konfigurację teraz, a Autouzupełnianie włączyć później na karcie Ustawienia aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode concluir a configuração agora e ativar o Preenchimento automático mais tarde no separador Definições da aplicação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puteți finaliza configurarea acum și activa Autocompletarea mai târziu din fila Setări a aplicației."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете завершить настройку сейчас, а автозаполнение включить позже на вкладке «Настройки» приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenie môžete dokončiť teraz a automatické dopĺňanie povoliť neskôr na karte Nastavenia aplikácie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavitev lahko dokončate zdaj, samodejno izpolnjevanje pa omogočite pozneje na zavihku Nastavitve aplikacije."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slutföra konfigurationen nu och aktivera Autofyll senare på appens flik Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณสามารถตั้งค่าให้เสร็จตอนนี้และเปิดใช้การป้อนอัตโนมัติภายหลังจากแท็บการตั้งค่าของแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurulumu şimdi tamamlayabilir ve Otomatik Doldurma'yı daha sonra uygulamanın Ayarlar sekmesinden etkinleştirebilirsiniz."
          }
