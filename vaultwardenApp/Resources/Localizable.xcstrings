        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오프라인 볼트 데이터, 변경 대기열 및 자동 완성 인덱스는 기기에서 암호화됩니다. 키는 iOS 키체인에 저장되며 내보내기에 포함되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saugyklos duomenys neprisijungus, pakeitimų eilės ir Automatinio pildymo indeksas šifruojami įrenginyje. Raktai saugomi iOS raktinėje ir neįtraukiami į eksportus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data peti besi luar talian, baris gilir perubahan dan indeks Isi Auto disulitkan pada peranti. Kunci disimpan dalam Rantai Kunci iOS dan tidak disertakan dalam eksport."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frakoblede hvelvdata, endringskøer og Autofyll-indeksen krypteres på enheten. Nøkler lagres i iOS-nøkkelringen og tas ikke med i eksporter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offlinekluisgegevens, wijzigingswachtrijen en de index voor Automatisch invullen zijn op het apparaat versleuteld. Sleutels worden bewaard in de iOS-sleutelhanger en worden niet opgenomen in exports."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane sejfu offline, kolejki zmian i indeks Autouzupełniania są szyfrowane na urządzeniu. Klucze są przechowywane w Pęku kluczy iOS i nie są uwzględniane w eksportach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados offline do cofre, as filas de alterações e o índice do Preenchimento automático são encriptados no dispositivo. As chaves são guardadas no Porta-chaves do iOS e não são incluídas nas exportações."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele offline ale seifului, cozile de modificări și indexul pentru Autocompletare sunt criptate pe dispozitiv. Cheile sunt stocate în Portcheiul iOS și nu sunt incluse în exporturi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн-данные хранилища, очереди изменений и индекс автозаполнения зашифрованы на устройстве. Ключи хранятся в Связке ключей iOS и не включаются в экспорт."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline údaje trezoru, fronty zmien a index automatického dopĺňania sú v zariadení zašifrované. Kľúče sú uložené v Kľúčenke iOS a nie sú zahrnuté v exportoch."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatki trezorja brez povezave, čakalne vrste sprememb in kazalo samodejnega izpolnjevanja so šifrirani v napravi. Ključi so shranjeni v Obesku za ključe iOS in niso vključeni v izvoze."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offlinedata i valvet, ändringsköer och Autofyll-indexet krypteras på enheten. Nycklar lagras i iOS-nyckelringen och inkluderas inte i exporter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลตู้นิรภัยออฟไลน์ คิวการเปลี่ยนแปลง และดัชนีป้อนอัตโนมัติจะถูกเข้ารหัสบนอุปกรณ์ คีย์จะเก็บไว้ในพวงกุญแจ iOS และไม่รวมในการส่งออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevrimdışı kasa verileri, değişiklik kuyrukları ve Otomatik Doldurma dizini aygıtta şifrelenir. Anahtarlar iOS Anahtar Zinciri'nde saklanır ve dışa aktarmalara dahil edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офлайн-дані сховища, черги змін та індекс автозаповнення шифруються на пристрої. Ключі зберігаються у В'язці ключів iOS і не включаються до експорту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu kho ngoại tuyến, hàng đợi thay đổi và chỉ mục Tự động điền được mã hóa trên thiết bị. Khóa được lưu trong Chuỗi khóa iOS và không được đưa vào bản xuất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线密码库数据、变更队列和自动填充索引均在设备上加密。密钥存储在 iOS 钥匙串中，不会包含在导出中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線密碼庫資料、變更佇列和自動填入索引均在裝置上加密。密鑰儲存在 iOS 鑰匙圈中，不會包含在匯出中。"
          }
        }
      }
    },
