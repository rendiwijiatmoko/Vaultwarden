        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ашу, көрсету, көшіру немесе толтыру алдында биометрияны талап ету."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
