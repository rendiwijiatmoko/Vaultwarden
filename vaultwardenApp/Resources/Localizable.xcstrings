    "Enable this app as a credential provider so passwords and verification codes appear outside the vault." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعّل هذا التطبيق كموفر لبيانات الاعتماد لتظهر كلمات المرور ورموز التحقق خارج الخزنة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включете това приложение като доставчик на идентификационни данни, за да се показват пароли и кодове за потвърждение извън трезора."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অ্যাপকে ক্রেডেনশিয়াল প্রদানকারী হিসেবে চালু করুন, যাতে ভল্টের বাইরেও পাসওয়ার্ড ও যাচাইকরণ কোড দেখা যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activeu aquesta aplicació com a proveïdor de credencials perquè les contrasenyes i els codis de verificació apareguin fora de la caixa forta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte tuto aplikaci jako poskytovatele přihlašovacích údajů, aby se hesla a ověřovací kódy zobrazovaly i mimo trezor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivér denne app som udbyder af loginoplysninger, så adgangskoder og bekræftelseskoder vises uden for boksen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere diese App als Anbieter von Zugangsdaten, damit Passwörter und Bestätigungscodes außerhalb des Tresors angezeigt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε αυτή την εφαρμογή ως πάροχο διαπιστευτηρίων ώστε οι κωδικοί και οι κωδικοί επαλήθευσης να εμφανίζονται εκτός της κρύπτης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this app as a credential provider so passwords and verification codes appear outside the vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa esta aplicación como proveedor de credenciales para que las contraseñas y los códigos de verificación aparezcan fuera de la caja fuerte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامه را به‌عنوان ارائه‌دهنده اطلاعات ورود فعال کنید تا کلمه‌های عبور و کدهای تأیید بیرون از گاوصندوق نمایش داده شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
