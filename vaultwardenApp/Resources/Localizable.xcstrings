    "Select one or more items from the list to use bulk actions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد عنصرًا واحدًا أو أكثر من القائمة لاستخدام الإجراءات المجمعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете един или повече елементи от списъка, за да използвате групови действия."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একসঙ্গে কাজ করতে তালিকা থেকে এক বা একাধিক আইটেম বেছে নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccioneu un o més elements de la llista per utilitzar accions en bloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte jednu nebo více položek ze seznamu a použijte hromadné akce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg et eller flere elementer på listen for at bruge massehandlinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen oder mehrere Einträge aus der Liste aus, um Massenaktionen zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε ένα ή περισσότερα στοιχεία από τη λίστα για να χρησιμοποιήσετε μαζικές ενέργειες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select one or more items from the list to use bulk actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona uno o varios elementos de la lista para utilizar acciones masivas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای استفاده از عملیات گروهی یک یا چند مورد را از فهرست انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse luettelosta vähintään yksi kohde käyttääksesi joukkotoimintoja."
