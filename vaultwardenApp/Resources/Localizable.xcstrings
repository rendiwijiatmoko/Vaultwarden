    "Vault data is sent only to the Vaultwarden server configured by the user. The app has no analytics, advertising SDK, or tracking domains." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُرسل بيانات الخزنة إلا إلى خادم Vaultwarden الذي يضبطه المستخدم. لا يحتوي التطبيق على تحليلات أو حزمة SDK إعلانية أو نطاقات تتبع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данните от трезора се изпращат само до сървъра на Vaultwarden, настроен от потребителя. Приложението няма анализи, рекламен SDK или домейни за проследяване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভল্টের ডেটা শুধু ব্যবহারকারীর কনফিগার করা Vaultwarden সার্ভারে পাঠানো হয়। অ্যাপটিতে কোনো অ্যানালিটিক্স, বিজ্ঞাপন SDK বা ট্র্যাকিং ডোমেইন নেই।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dades de la caixa forta només s'envien al servidor Vaultwarden configurat per l'usuari. L'aplicació no té analítica, SDK de publicitat ni dominis de seguiment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data trezoru jsou odesílána pouze na server Vaultwarden nastavený uživatelem. Aplikace neobsahuje analytiku, reklamní SDK ani sledovací domény."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data fra boksen sendes kun til den Vaultwarden-server, som brugeren har konfigureret. Appen har ingen analyse, reklame-SDK eller sporingsdomæner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tresordaten werden ausschließlich an den vom Benutzer konfigurierten Vaultwarden-Server gesendet. Die App enthält keine Analyse- oder Werbe-SDKs und keine Tracking-Domains."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δεδομένα της κρύπτης αποστέλλονται μόνο στον διακομιστή Vaultwarden που έχει ρυθμίσει ο χρήστης. Η εφαρμογή δεν διαθέτει αναλυτικά στοιχεία, SDK διαφημίσεων ή τομείς παρακολούθησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vault data is sent only to the Vaultwarden server configured by the user. The app has no analytics, advertising SDK, or tracking domains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de la caja fuerte solo se envían al servidor Vaultwarden configurado por el usuario. La aplicación no contiene analítica, SDK publicitarios ni dominios de seguimiento."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داده‌های گاوصندوق فقط به سرور Vaultwarden پیکربندی‌شده توسط کاربر ارسال می‌شوند. برنامه هیچ تحلیل‌گر، SDK تبلیغاتی یا دامنه ردیابی ندارد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holvin tiedot lähetetään vain käyttäjän määrittämälle Vaultwarden-palvelimelle. Sovelluksessa ei ole analytiikkaa, mainonta-SDK:ta tai seurantatoimialueita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du coffre sont envoyées uniquement au serveur Vaultwarden configuré par l’utilisateur. L’application ne contient aucun outil d’analyse, SDK publicitaire ou domaine de suivi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתוני הכספת נשלחים רק לשרת Vaultwarden שהוגדר בידי המשתמש. ליישום אין כלי ניתוח, SDK לפרסום או דומיינים למעקב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तिजोरी डेटा केवल उपयोगकर्ता द्वारा कॉन्फ़िगर किए गए Vaultwarden सर्वर को भेजा जाता है। ऐप में कोई एनालिटिक्स, विज्ञापन SDK या ट्रैकिंग डोमेन नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci trezora šalju se samo na Vaultwarden poslužitelj koji je postavio korisnik. Aplikacija nema analitiku, oglasni SDK ni domene za praćenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A széfadatok csak a felhasználó által beállított Vaultwarden-szerverre kerülnek. Az alkalmazás nem tartalmaz analitikát, hirdetési SDK-t vagy követési tartományokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data brankas hanya dikirim ke server Vaultwarden yang dikonfigurasi pengguna. Aplikasi tidak memiliki analitik, SDK iklan, atau domain pelacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati della cassaforte vengono inviati solo al server Vaultwarden configurato dall'utente. L'app non contiene analisi, SDK pubblicitari o domini di tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫のデータは、ユーザーが設定したVaultwardenサーバーにのみ送信されます。このアプリには分析機能、広告SDK、追跡ドメインはありません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қойма деректері тек пайдаланушы баптаған Vaultwarden серверіне жіберіледі. Қолданбада аналитика, жарнама SDK немесе бақылау домендері жоқ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "볼트 데이터는 사용자가 설정한 Vaultwarden 서버로만 전송됩니다. 앱에는 분석, 광고 SDK 또는 추적 도메인이 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saugyklos duomenys siunčiami tik į naudotojo sukonfigūruotą Vaultwarden serverį. Programoje nėra analizės, reklamos SDK ar sekimo domenų."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data peti besi hanya dihantar kepada pelayan Vaultwarden yang dikonfigurasikan pengguna. Aplikasi tidak mempunyai analitik, SDK pengiklanan atau domain penjejakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvelvdata sendes bare til Vaultwarden-serveren som brukeren har konfigurert. Appen har ingen analyse, reklame-SDK eller sporingsdomener."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kluisgegevens worden alleen verzonden naar de Vaultwarden-server die door de gebruiker is geconfigureerd. De app bevat geen analyse, advertentie-SDK of trackingdomeinen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane sejfu są wysyłane wyłącznie na serwer Vaultwarden skonfigurowany przez użytkownika. Aplikacja nie zawiera analityki, reklamowych zestawów SDK ani domen śledzących."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do cofre são enviados apenas para o servidor Vaultwarden configurado pelo utilizador. A aplicação não inclui análise, SDK de publicidade nem domínios de monitorização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datele seifului sunt trimise numai către serverul Vaultwarden configurat de utilizator. Aplicația nu include analiză, SDK-uri de publicitate sau domenii de urmărire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные хранилища отправляются только на сервер Vaultwarden, настроенный пользователем. В приложении нет аналитики, рекламных SDK и отслеживающих доменов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje trezoru sa odosielajú iba na server Vaultwarden nakonfigurovaný používateľom. Aplikácia neobsahuje analytiku, reklamné súpravy SDK ani sledovacie domény."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podatki trezorja so poslani samo strežniku Vaultwarden, ki ga nastavi uporabnik. Aplikacija nima analitike, oglaševalskih kompletov SDK ali domen za sledenje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valvdata skickas endast till den Vaultwarden-server som användaren har konfigurerat. Appen har ingen analys, inga SDK:er för annonser och inga spårningsdomäner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลตู้นิรภัยจะถูกส่งไปยังเซิร์ฟเวอร์ Vaultwarden ที่ผู้ใช้กำหนดค่าเท่านั้น แอปไม่มีการวิเคราะห์ SDK โฆษณา หรือโดเมนติดตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasa verileri yalnızca kullanıcı tarafından yapılandırılan Vaultwarden sunucusuna gönderilir. Uygulamada analiz, reklam SDK'sı veya izleme alan adı yoktur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані сховища надсилаються лише на сервер Vaultwarden, налаштований користувачем. Програма не містить аналітики, рекламних SDK або доменів відстеження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu kho chỉ được gửi đến máy chủ Vaultwarden do người dùng cấu hình. Ứng dụng không có công cụ phân tích, SDK quảng cáo hoặc tên miền theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码库数据仅发送到用户配置的 Vaultwarden 服务器。此应用没有分析、广告 SDK 或跟踪域名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼庫資料僅發送到使用者設定的 Vaultwarden 伺服器。此應用程式沒有分析、廣告 SDK 或追蹤網域。"
          }
        }
      }
    },
