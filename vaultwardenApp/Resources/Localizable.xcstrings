    "Choose when iOS should verify that it is really you. These options can be changed later." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر متى يجب على iOS التحقق من هويتك. يمكن تغيير هذه الخيارات لاحقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете кога iOS да проверява, че това наистина сте Вие. Тези настройки могат да се променят по-късно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS কখন নিশ্চিত করবে যে এটি সত্যিই আপনি, তা বেছে নিন। এই বিকল্পগুলো পরে পরিবর্তন করা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trieu quan voleu que iOS verifiqui que realment sou vosaltres. Aquestes opcions es poden canviar més endavant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, kdy má iOS ověřit, že jste to opravdu vy. Tyto možnosti lze později změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvornår iOS skal bekræfte, at det virkelig er dig. Disse indstillinger kan ændres senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle aus, wann iOS überprüfen soll, dass du es wirklich bist. Diese Optionen können später geändert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε πότε το iOS θα πρέπει να επαληθεύει ότι είστε πράγματι εσείς. Αυτές οι επιλογές μπορούν να αλλάξουν αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose when iOS should verify that it is really you. These options can be changed later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuándo debe verificar iOS que realmente eres tú. Estas opciones se pueden cambiar más adelante."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زمانی را انتخاب کنید که iOS باید هویت شما را تأیید کند. این گزینه‌ها بعداً قابل تغییرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, milloin iOS varmistaa, että kyseessä olet todella sinä. Näitä asetuksia voi muuttaa myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez quand iOS doit vérifier qu’il s’agit bien de vous. Ces options pourront être modifiées ultérieurement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבחור מתי iOS יאמת שזה אכן אתם. ניתן לשנות אפשרויות אלה מאוחר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि iOS कब सत्यापित करे कि यह वास्तव में आप ही हैं। इन विकल्पों को बाद में बदला जा सकता है।"
