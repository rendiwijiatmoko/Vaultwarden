        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reikalauti biometrinių duomenų prieš atrakinant, rodant, kopijuojant ar pildant."
          }
        },
        "ms" : {
          "stringUnit" : {
