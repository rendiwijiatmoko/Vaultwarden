    "Values you copy, save, or replace with Regenerate will appear here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر هنا القيم التي تنسخها أو تحفظها أو تستبدلها باستخدام إعادة الإنشاء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стойностите, които копирате, запазвате или заменяте чрез повторно генериране, ще се показват тук."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যেসব মান কপি, সংরক্ষণ বা আবার তৈরি করে প্রতিস্থাপন করবেন সেগুলো এখানে দেখা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els valors que copieu, deseu o substituïu amb Torna a generar apareixeran aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnoty, které zkopírujete, uložíte nebo nahradíte opětovným vygenerováním, se zobrazí zde."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdier, du kopierer, gemmer eller erstatter med Generér igen, vises her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werte, die du kopierst, speicherst oder mit „Neu generieren“ ersetzt, werden hier angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές που αντιγράφετε, αποθηκεύετε ή αντικαθιστάτε με την Επαναδημιουργία θα εμφανίζονται εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Values you copy, save, or replace with Regenerate will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores que copies, guardes o sustituyas con Regenerar aparecerán aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقادیری که کپی، ذخیره یا با «تولید دوباره» جایگزین می‌کنید اینجا نمایش داده می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopioimasi, tallentamasi tai Luo uudelleen -toiminnolla korvaamasi arvot näkyvät tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs que vous copiez, enregistrez ou remplacez avec Régénérer apparaîtront ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכים שתעתיקו, תשמרו או תחליפו באמצעות יצירה מחדש יופיעו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके कॉपी, सहेजे या फिर से जनरेट करके बदले गए मान यहाँ दिखाई देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijednosti koje kopiraš, spremaš ili zamijeniš ponovnim generiranjem prikazat će se ovdje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A másolt, mentett vagy az Újragenerálással lecserélt értékek itt jelennek meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai yang Anda salin, simpan, atau ganti dengan Buat Ulang akan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori copiati, salvati o sostituiti con Rigenera appariranno qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピー、保存、または「再生成」で置き換えた値がここに表示されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көшірілген, сақталған немесе Қайта жасау арқылы ауыстырылған мәндер осында көрсетіледі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사하거나 저장하거나 다시 생성으로 바꾼 값이 여기에 표시됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nukopijuotos, išsaugotos ar naudojant Generuoti iš naujo pakeistos reikšmės bus rodomos čia."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nilai yang anda salin, simpan atau ganti dengan Jana Semula akan muncul di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdier du kopierer, lagrer eller erstatter med Generer på nytt, vises her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarden die je kopieert, opslaat of vervangt met Opnieuw genereren verschijnen hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartości skopiowane, zapisane lub zastąpione przez ponowne generowanie pojawią się tutaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores que copiar, guardar ou substituir com Gerar novamente aparecerão aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valorile pe care le copiați, salvați sau înlocuiți cu Regenerare vor apărea aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся значения, которые вы копируете, сохраняете или заменяете с помощью повторного создания."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnoty, ktoré skopírujete, uložíte alebo nahradíte opätovným vygenerovaním, sa zobrazia tu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrednosti, ki jih kopirate, shranite ali zamenjate z možnostjo Ustvari znova, bodo prikazane tukaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värden som du kopierar, sparar eller ersätter med Generera igen visas här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าที่คุณคัดลอก บันทึก หรือแทนที่ด้วยสร้างใหม่จะปรากฏที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopyaladığınız, kaydettiğiniz veya Yeniden Oluştur ile değiştirdiğiniz değerler burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення, які ви копіюєте, зберігаєте або замінюєте за допомогою «Згенерувати знову», з'являться тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các giá trị bạn sao chép, lưu hoặc thay thế bằng Tạo lại sẽ xuất hiện tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您复制、保存或通过“重新生成”替换的值将显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您複製、儲存或通過“重新產生”替換的值將顯示在這裡。"
          }
        }
      }
    },
