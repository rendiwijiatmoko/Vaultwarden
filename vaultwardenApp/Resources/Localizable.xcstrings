    "Your master password is used to unlock the encrypted vault and is never saved as plain text." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم كلمة المرور الرئيسية لفتح الخزنة المشفرة ولا تُحفظ أبدًا كنص عادي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главната Ви парола се използва за отключване на шифрования трезор и никога не се запазва като обикновен текст."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্রধান পাসওয়ার্ড এনক্রিপ্ট করা ভল্ট আনলক করতে ব্যবহৃত হয় এবং কখনোই সাধারণ টেক্সট হিসেবে সংরক্ষণ করা হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrasenya mestra s'utilitza per desbloquejar la caixa forta xifrada i mai no es desa com a text sense format."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlavní heslo se používá k odemknutí šifrovaného trezoru a nikdy se neukládá jako prostý text."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din hovedadgangskode bruges til at låse den krypterede boks op og gemmes aldrig som almindelig tekst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Master-Passwort wird zum Entsperren des verschlüsselten Tresors verwendet und niemals als Klartext gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κύριος κωδικός σας χρησιμοποιείται για το ξεκλείδωμα της κρυπτογραφημένης κρύπτης και δεν αποθηκεύεται ποτέ ως απλό κείμενο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your master password is used to unlock the encrypted vault and is never saved as plain text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña maestra se utiliza para desbloquear la caja fuerte cifrada y nunca se guarda como texto sin formato."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلمه عبور اصلی برای باز کردن گاوصندوق رمزگذاری‌شده استفاده می‌شود و هرگز به‌صورت متن ساده ذخیره نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pääsalasanaasi käytetään salatun holvin lukituksen avaamiseen, eikä sitä koskaan tallenneta selväkielisenä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe principal sert à déverrouiller le coffre chiffré et n’est jamais enregistré en texte brut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיסמת האב משמשת לביטול נעילת הכספת המוצפנת ולעולם אינה נשמרת כטקסט גלוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका मास्टर पासवर्ड एन्क्रिप्टेड तिजोरी अनलॉक करने के लिए उपयोग होता है और कभी भी प्लेन टेक्स्ट में संग्रहीत नहीं होता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glavna lozinka koristi se za otključavanje šifriranog trezora i nikada se ne sprema kao običan tekst."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesterjelszó a titkosított széf feloldására szolgál, és soha nem tárolódik egyszerű szövegként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi utama digunakan untuk membuka brankas terenkripsi dan tidak pernah disimpan sebagai teks biasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password principale serve a sbloccare la cassaforte crittografata e non viene mai salvata come testo in chiaro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスターパスワードは暗号化された保管庫のロック解除に使用され、平文で保存されることはありません。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Негізгі құпиясөзіңіз шифрланған қойманы ашу үшін пайдаланылады және ешқашан ашық мәтін ретінде сақталмайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마스터 비밀번호는 암호화된 볼트를 잠금 해제하는 데 사용되며 일반 텍스트로 저장되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagrindinis slaptažodis naudojamas šifruotai saugyklai atrakinti ir niekada nesaugomas kaip paprastas tekstas."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata laluan induk digunakan untuk membuka peti besi disulitkan dan tidak pernah disimpan sebagai teks biasa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hovedpassordet brukes til å låse opp det krypterte hvelvet og lagres aldri som ren tekst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoofdwachtwoord wordt gebruikt om de versleutelde kluis te ontgrendelen en wordt nooit als platte tekst opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło główne służy do odblokowania zaszyfrowanego sejfu i nigdy nie jest zapisywane jako zwykły tekst."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua palavra-passe mestra é utilizada para desbloquear o cofre encriptado e nunca é guardada como texto simples."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola principală este utilizată pentru a debloca seiful criptat și nu este niciodată salvată ca text simplu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мастер-пароль используется для разблокировки зашифрованного хранилища и никогда не сохраняется в виде обычного текста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlavné heslo sa používa na odomknutie zašifrovaného trezoru a nikdy sa neukladá ako obyčajný text."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glavno geslo se uporablja za odklepanje šifriranega trezorja in se nikoli ne shrani kot navadno besedilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt huvudlösenord används för att låsa upp det krypterade valvet och sparas aldrig som vanlig text."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสผ่านหลักใช้เพื่อปลดล็อกตู้นิรภัยที่เข้ารหัสและจะไม่ถูกบันทึกเป็นข้อความธรรมดา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana parolanız şifreli kasanın kilidini açmak için kullanılır ve hiçbir zaman düz metin olarak kaydedilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Головний пароль використовується для розблокування зашифрованого сховища й ніколи не зберігається як звичайний текст."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu chính được dùng để mở khóa kho đã mã hóa và không bao giờ được lưu dưới dạng văn bản thuần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主密码用于解锁加密密码库，绝不会以明文形式保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主密碼用於解鎖加密密碼庫，絕不會以明文形式儲存。"
          }
        }
      }
    },
