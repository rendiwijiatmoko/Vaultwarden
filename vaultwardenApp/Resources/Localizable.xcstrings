    "Text Sends are encrypted locally and can be queued securely when offline." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُشفّر عمليات إرسال النصوص محليًا ويمكن وضعها بأمان في قائمة الانتظار عند عدم الاتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстовите Send се шифроват локално и могат сигурно да чакат, когато сте офлайн."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টেক্সট Send স্থানীয়ভাবে এনক্রিপ্ট করা হয় এবং অফলাইনে নিরাপদে অপেক্ষমাণ রাখা যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els Send de text es xifren localment i es poden posar a la cua de manera segura quan no hi ha connexió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textové Sendy jsou šifrovány místně a v režimu offline mohou bezpečně čekat ve frontě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst-Sends krypteres lokalt og kan sættes sikkert i kø, når du er offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text-Sends werden lokal verschlüsselt und können offline sicher in die Warteschlange gestellt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα Sends κειμένου κρυπτογραφούνται τοπικά και μπορούν να τοποθετηθούν με ασφάλεια στην ουρά όταν είστε εκτός σύνδεσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text Sends are encrypted locally and can be queued securely when offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Send de texto se cifran localmente y se pueden poner en cola de forma segura cuando no hay conexión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendهای متنی محلی رمزگذاری می‌شوند و هنگام آفلاین بودن با ایمنی در صف قرار می‌گیرند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksti-Sendit salataan paikallisesti, ja ne voidaan asettaa turvallisesti jonoon offline-tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les Sends de texte sont chiffrés localement et peuvent être mis en attente en toute sécurité hors ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends של טקסט מוצפנים מקומית וניתן להוסיף אותם בבטחה לתור כשאינכם מחוברים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट सेंड लोकल रूप से एन्क्रिप्ट होते हैं और ऑफ़लाइन होने पर सुरक्षित रूप से कतार में रखे जा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstualni Sendovi šifriraju se lokalno i mogu sigurno čekati kada nema mrežne veze."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szöveges Sendek helyileg titkosítódnak, és offline állapotban biztonságosan sorba állíthatók."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send teks dienkripsi secara lokal dan dapat dimasukkan ke antrean dengan aman saat offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Send di testo sono crittografati localmente e possono essere messi in coda in modo sicuro quando sei offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストSendはローカルで暗号化され、オフライン時も安全に待機させることができます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мәтіндік Sends жергілікті шифрланады және офлайн кезде қауіпсіз кезекке қойылады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 Send는 로컬에서 암호화되며 오프라인에서도 안전하게 대기열에 넣을 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstiniai Send šifruojami vietoje ir gali būti saugiai įtraukti į eilę neprisijungus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
