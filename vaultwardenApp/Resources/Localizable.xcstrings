    "Uses Have I Been Pwned k-anonymity. Only a five-character hash prefix is sent; the password stays on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم إخفاء الهوية الجزئي k-anonymity من Have I Been Pwned. تُرسل فقط بادئة تجزئة من خمسة أحرف؛ وتبقى كلمة المرور على هذا الجهاز."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва k-анонимността на Have I Been Pwned. Изпраща се само петзнаков префикс на хеша; паролата остава на това устройство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have I Been Pwned-এর k-anonymity ব্যবহার করে। শুধু পাঁচ অক্ষরের হ্যাশ প্রিফিক্স পাঠানো হয়; পাসওয়ার্ডটি এই ডিভাইসেই থাকে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitza la k-anonimitat de Have I Been Pwned. Només s'envia un prefix de hash de cinc caràcters; la contrasenya es manté en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá k-anonymitu služby Have I Been Pwned. Odesílá se pouze pětiznaková předpona hashe; heslo zůstává v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger k-anonymitet fra Have I Been Pwned. Kun et hashpræfiks på fem tegn sendes; adgangskoden bliver på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet die k-Anonymität von Have I Been Pwned. Nur ein fünf Zeichen langes Hash-Präfix wird gesendet; das Passwort bleibt auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί την k-ανωνυμία του Have I Been Pwned. Αποστέλλεται μόνο ένα πρόθεμα κατακερματισμού πέντε χαρακτήρων· ο κωδικός παραμένει σε αυτή τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses Have I Been Pwned k-anonymity. Only a five-character hash prefix is sent; the password stays on this device."
          }
