    "Used when a login URI does not define its own match rule. Per-item URI settings always take priority." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم عندما لا يحدد URI لتسجيل الدخول قاعدة المطابقة الخاصة به. تكون لإعدادات URI لكل عنصر الأولوية دائمًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Използва се, когато URI за вход няма собствено правило за съвпадение. Настройките за URI на отделния елемент винаги са с предимство."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লগইন URI-তে নিজস্ব মিলের নিয়ম না থাকলে এটি ব্যবহৃত হয়। প্রতিটি আইটেমের URI সেটিংস সবসময় অগ্রাধিকার পায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'utilitza quan un URI d'inici de sessió no defineix la seva pròpia regla de coincidència. La configuració d'URI de cada element sempre té prioritat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá se, pokud přihlašovací URI nedefinuje vlastní pravidlo shody. Nastavení URI jednotlivých položek má vždy přednost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges, når en login-URI ikke angiver sin egen regel for match. URI-indstillinger for det enkelte element har altid prioritet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, wenn eine Anmelde-URI keine eigene Abgleichregel definiert. Eintragsspezifische URI-Einstellungen haben immer Vorrang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται όταν ένα URI σύνδεσης δεν ορίζει δικό του κανόνα αντιστοίχισης. Οι ρυθμίσεις URI ανά στοιχείο έχουν πάντα προτεραιότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used when a login URI does not define its own match rule. Per-item URI settings always take priority."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se utiliza cuando un URI de inicio de sesión no define su propia regla de coincidencia. Los ajustes de URI de cada elemento siempre tienen prioridad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگامی استفاده می‌شود که URI ورود قانون تطابق خودش را نداشته باشد. تنظیمات URI هر مورد همیشه اولویت دارند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään, kun kirjautumis-URI ei määritä omaa vastaavuussääntöään. Kohdekohtaiset URI-asetukset ovat aina etusijalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé lorsqu’un URI de connexion ne définit pas sa propre règle de correspondance. Les paramètres d’URI propres à chaque élément sont toujours prioritaires."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמש כאשר URI של התחברות אינו מגדיר כלל התאמה משלו. הגדרות URI לכל פריט תמיד מקבלות עדיפות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब किसी लॉगिन URI का अपना मिलान नियम नहीं होता, तब इसका उपयोग होता है। हर आइटम की URI सेटिंग हमेशा प्राथमिकता लेती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se kada URI za prijavu ne definira vlastito pravilo podudaranja. Postavke URI-ja pojedinačne stavke uvijek imaju prednost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkor használatos, ha egy bejelentkezési URI nem határoz meg saját egyezési szabályt. Az elemenkénti URI-beállítások mindig elsőbbséget élveznek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan saat URI login tidak menentukan aturan kecocokannya sendiri. Pengaturan URI per item selalu diprioritaskan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato quando un URI di accesso non definisce una propria regola di corrispondenza. Le impostazioni URI per elemento hanno sempre la precedenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインURIに独自の一致ルールが定義されていない場合に使用されます。項目ごとのURI設定が常に優先されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кіру URI мекенжайы өз сәйкестік ережесін анықтамағанда қолданылады. Әр элементтің URI параметрлері әрқашан басым."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 URI에 자체 일치 규칙이 없을 때 사용됩니다. 항목별 URI 설정이 항상 우선합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudojama, kai prisijungimo URI neturi savo atitikties taisyklės. Atskiro elemento URI nuostatos visada turi pirmenybę."
          }
        },
        "ms" : {
          "stringUnit" : {
