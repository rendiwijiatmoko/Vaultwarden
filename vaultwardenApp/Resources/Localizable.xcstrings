    "This removes the downloaded offline cache. It does not delete server data or queued offline changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة ذاكرة التخزين المؤقت المنزلة للاستخدام دون اتصال. ولا يحذف بيانات الخادم أو التغييرات الموضوعة في قائمة الانتظار دون اتصال."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това премахва изтегления офлайн кеш. Не изтрива данните на сървъра или чакащите офлайн промени."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি ডাউনলোড করা অফলাইন ক্যাশ সরিয়ে দেয়। সার্ভারের ডেটা বা অপেক্ষমাণ অফলাইন পরিবর্তন মুছে দেয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això elimina la memòria cau fora de línia baixada. No suprimeix les dades del servidor ni els canvis fora de línia a la cua."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tím se odstraní stažená offline mezipaměť. Data serveru ani čekající offline změny se neodstraní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
