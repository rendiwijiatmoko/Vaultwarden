    "Only approve a request you started on another device. Check the device and IP address before continuing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وافق فقط على طلب بدأته على جهاز آخر. تحقق من الجهاز وعنوان IP قبل المتابعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одобрявайте само заявка, която сте започнали на друго устройство. Проверете устройството и IP адреса, преди да продължите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অন্য ডিভাইসে আপনি যে অনুরোধ শুরু করেছেন শুধু সেটিই অনুমোদন করুন। চালিয়ে যাওয়ার আগে ডিভাইস ও IP ঠিকানা পরীক্ষা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproveu només una sol·licitud que hàgiu iniciat en un altre dispositiu. Comproveu el dispositiu i l'adreça IP abans de continuar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schvalte pouze požadavek, který jste zahájili na jiném zařízení. Před pokračováním zkontrolujte zařízení a IP adresu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkend kun en anmodning, du selv har startet på en anden enhed. Kontrollér enheden og IP-adressen, før du fortsætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genehmige nur eine Anfrage, die du auf einem anderen Gerät gestartet hast. Prüfe Gerät und IP-Adresse, bevor du fortfährst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγκρίνετε μόνο ένα αίτημα που ξεκινήσατε σε άλλη συσκευή. Ελέγξτε τη συσκευή και τη διεύθυνση IP πριν συνεχίσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only approve a request you started on another device. Check the device and IP address before continuing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba únicamente una solicitud que hayas iniciado en otro dispositivo. Comprueba el dispositivo y la dirección IP antes de continuar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط درخواستی را تأیید کنید که در دستگاه دیگری آغاز کرده‌اید. پیش از ادامه، دستگاه و نشانی IP را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyväksy vain pyyntö, jonka aloitit toisella laitteella. Tarkista laite ja IP-osoite ennen jatkamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’approuvez qu’une demande que vous avez lancée sur un autre appareil. Vérifiez l’appareil et l’adresse IP avant de continuer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאשר רק בקשה שהתחלתם במכשיר אחר. בדקו את המכשיר ואת כתובת ה-IP לפני שתמשיכו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल वही अनुरोध स्वीकार करें जो आपने किसी दूसरे डिवाइस पर शुरू किया हो। आगे बढ़ने से पहले डिवाइस और IP पता जाँचें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odobri samo zahtjev koji si pokrenuo/la na drugom uređaju. Provjeri uređaj i IP adresu prije nastavka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak olyan kérelmet hagyjon jóvá, amelyet másik eszközön Ön indított. Folytatás előtt ellenőrizze az eszközt és az IP-címet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya setujui permintaan yang Anda mulai di perangkat lain. Periksa perangkat dan alamat IP sebelum melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva solo una richiesta che hai avviato su un altro dispositivo. Controlla il dispositivo e l'indirizzo IP prima di continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスで自分が開始した要求のみ承認してください。続行する前にデバイスとIPアドレスを確認してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Басқа құрылғыда өзіңіз бастаған сұрауды ғана мақұлдаңыз. Жалғастырмас бұрын құрылғы мен IP мекенжайын тексеріңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서 직접 시작한 요청만 승인하세요. 계속하기 전에 기기와 IP 주소를 확인하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patvirtinkite tik užklausą, kurią pradėjote kitame įrenginyje. Prieš tęsdami patikrinkite įrenginį ir IP adresą."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luluskan hanya permintaan yang anda mulakan pada peranti lain. Semak peranti dan alamat IP sebelum meneruskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkjenn bare en forespørsel du startet på en annen enhet. Kontroller enheten og IP-adressen før du fortsetter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keur alleen een verzoek goed dat je zelf op een ander apparaat hebt gestart. Controleer het apparaat en IP-adres voordat je doorgaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatwierdzaj tylko żądania rozpoczęte przez Ciebie na innym urządzeniu. Przed kontynuacją sprawdź urządzenie i adres IP."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprove apenas um pedido iniciado por si noutro dispositivo. Verifique o dispositivo e o endereço IP antes de continuar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprobați numai o cerere inițiată de dvs. pe alt dispozitiv. Verificați dispozitivul și adresa IP înainte de a continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одобряйте только запрос, начатый вами на другом устройстве. Перед продолжением проверьте устройство и IP-адрес."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schváľte iba žiadosť, ktorú ste začali na inom zariadení. Pred pokračovaním skontrolujte zariadenie a IP adresu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odobrite samo zahtevo, ki ste jo začeli v drugi napravi. Pred nadaljevanjem preverite napravo in naslov IP."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godkänn endast en begäran som du startade på en annan enhet. Kontrollera enheten och IP-adressen innan du fortsätter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุมัติเฉพาะคำขอที่คุณเริ่มจากอุปกรณ์อื่น ตรวจสอบอุปกรณ์และที่อยู่ IP ก่อนดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca başka bir aygıtta başlattığınız isteği onaylayın. Devam etmeden önce aygıtı ve IP adresini kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схвалюйте лише запит, який ви почали на іншому пристрої. Перевірте пристрій та IP-адресу перед продовженням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ phê duyệt yêu cầu do bạn bắt đầu trên thiết bị khác. Kiểm tra thiết bị và địa chỉ IP trước khi tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅批准由您在其他设备上发起的请求。继续前请检查设备和 IP 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅批准由您在其他裝置上發起的請求。繼續前請檢查裝置和 IP 地址。"
          }
        }
      }
    },
    "Only HTTPS servers should be accepted in production. Certificate validation must never be disabled." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب قبول خوادم HTTPS فقط في بيئة الإنتاج. يجب عدم تعطيل التحقق من الشهادات مطلقًا."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В работна среда трябва да се приемат само HTTPS сървъри. Проверката на сертификатите никога не трябва да се изключва."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রোডাকশনে শুধু HTTPS সার্ভার গ্রহণ করা উচিত। সার্টিফিকেট যাচাইকরণ কখনোই বন্ধ করা যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En producció només s'han d'acceptar servidors HTTPS. La validació de certificats no s'ha de desactivar mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V produkčním prostředí by měly být přijímány pouze servery HTTPS. Ověřování certifikátů nesmí být nikdy vypnuto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun HTTPS-servere bør accepteres i produktion. Certifikatvalidering må aldrig deaktiveres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Produktion sollten nur HTTPS-Server akzeptiert werden. Die Zertifikatsprüfung darf niemals deaktiviert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην παραγωγή πρέπει να γίνονται δεκτοί μόνο διακομιστές HTTPS. Η επικύρωση πιστοποιητικών δεν πρέπει ποτέ να απενεργοποιείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only HTTPS servers should be accepted in production. Certificate validation must never be disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En producción solo deben aceptarse servidores HTTPS. La validación de certificados nunca debe desactivarse."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در محیط عملیاتی فقط سرورهای HTTPS باید پذیرفته شوند. اعتبارسنجی گواهی هرگز نباید غیرفعال شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuotannossa tulee hyväksyä vain HTTPS-palvelimia. Varmenteen tarkistusta ei saa koskaan poistaa käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les serveurs HTTPS doivent être acceptés en production. La validation des certificats ne doit jamais être désactivée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בסביבת ייצור יש לקבל רק שרתי HTTPS. לעולם אין להשבית את אימות האישורים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोडक्शन में केवल HTTPS सर्वर स्वीकार किए जाने चाहिए। सर्टिफ़िकेट सत्यापन कभी अक्षम नहीं होना चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U proizvodnom okruženju prihvaćaju se samo HTTPS poslužitelji. Provjera certifikata nikada se ne smije isključiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éles környezetben csak HTTPS-szerverek fogadhatók el. A tanúsítvány-ellenőrzést soha nem szabad kikapcsolni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya server HTTPS yang boleh diterima dalam produksi. Validasi sertifikat tidak boleh dinonaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In produzione devono essere accettati solo server HTTPS. La convalida dei certificati non deve mai essere disabilitata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本番環境ではHTTPSサーバーのみを使用してください。証明書の検証は絶対に無効にしないでください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өндірісте тек HTTPS серверлері қабылдануы керек. Сертификатты тексеруді ешқашан өшіруге болмайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운영 환경에서는 HTTPS 서버만 허용해야 합니다. 인증서 검증을 절대 비활성화하지 마세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamybinėje aplinkoje turėtų būti priimami tik HTTPS serveriai. Sertifikatų tikrinimo niekada negalima išjungti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya pelayan HTTPS patut diterima dalam pengeluaran. Pengesahan sijil tidak boleh dilumpuhkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare HTTPS-servere bør godtas i produksjon. Sertifikatvalidering må aldri deaktiveres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In productie mogen alleen HTTPS-servers worden geaccepteerd. Certificaatvalidatie mag nooit worden uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W środowisku produkcyjnym należy akceptować wyłącznie serwery HTTPS. Nie wolno wyłączać sprawdzania certyfikatów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em produção, apenas devem ser aceites servidores HTTPS. A validação de certificados nunca deve ser desativada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În producție trebuie acceptate numai servere HTTPS. Validarea certificatelor nu trebuie dezactivată niciodată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В рабочей среде следует принимать только серверы HTTPS. Проверку сертификатов нельзя отключать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V produkcii by mali byť prijaté iba servery HTTPS. Overovanie certifikátov nesmie byť nikdy zakázané."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V produkciji naj bodo sprejeti samo strežniki HTTPS. Preverjanja potrdil se nikoli ne sme onemogočiti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast HTTPS-servrar bör godtas i produktion. Certifikatverifiering får aldrig inaktiveras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในระบบใช้งานจริงควรยอมรับเฉพาะเซิร์ฟเวอร์ HTTPS และห้ามปิดการตรวจสอบใบรับรอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üretimde yalnızca HTTPS sunucuları kabul edilmelidir. Sertifika doğrulaması hiçbir zaman devre dışı bırakılmamalıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У робочому середовищі слід приймати лише сервери HTTPS. Перевірку сертифікатів ніколи не можна вимикати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ nên chấp nhận máy chủ HTTPS trong môi trường sản xuất. Tuyệt đối không được tắt xác thực chứng chỉ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生产环境中只应接受 HTTPS 服务器，绝不能禁用证书验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生產環境中只應接受 HTTPS 伺服器，絕不能禁用證書驗證。"
          }
        }
      }
    },
