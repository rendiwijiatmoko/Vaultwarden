    "Vaultwarden highlights passwords that may be exposed, weak, reused, or used on unsecured websites so you can update them quickly." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبرز Vaultwarden كلمات المرور التي قد تكون مكشوفة أو ضعيفة أو معاد استخدامها أو مستخدمة على مواقع غير آمنة لتتمكن من تحديثها بسرعة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden откроява паролите, които може да са разкрити, слаби, използвани повторно или използвани в незащитени уебсайтове, за да можете бързо да ги обновите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden এমন পাসওয়ার্ড চিহ্নিত করে যেগুলো ফাঁস, দুর্বল, পুনরায় ব্যবহৃত বা অনিরাপদ ওয়েবসাইটে ব্যবহৃত হতে পারে, যাতে আপনি দ্রুত সেগুলো হালনাগাদ করতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden destaca les contrasenyes que poden estar exposades, ser febles, reutilitzades o utilitzades en llocs web no segurs perquè les pugueu actualitzar ràpidament."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden zvýrazňuje hesla, která mohou být prozrazena, slabá, opakovaně použitá nebo použitá na nezabezpečených webech, abyste je mohli rychle aktualizovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden fremhæver adgangskoder, der kan være lækket, svage, genbrugte eller brugt på usikre websteder, så du hurtigt kan opdatere dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden hebt Passwörter hervor, die offengelegt, schwach, wiederverwendet oder auf ungesicherten Websites verwendet sein könnten, damit du sie schnell aktualisieren kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Vaultwarden επισημαίνει κωδικούς που ενδέχεται να έχουν εκτεθεί, να είναι αδύναμοι, να επαναχρησιμοποιούνται ή να χρησιμοποιούνται σε μη ασφαλείς ιστοτόπους, ώστε να μπορείτε να τους ενημερώσετε γρήγορα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden highlights passwords that may be exposed, weak, reused, or used on unsecured websites so you can update them quickly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden destaca las contraseñas que pueden estar expuestas, ser débiles, reutilizadas o utilizadas en sitios web no seguros para que puedas actualizarlas rápidamente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden کلمه‌های عبور احتمالاً افشاشده، ضعیف، تکراری یا استفاده‌شده در وب‌سایت‌های ناامن را برجسته می‌کند تا سریع آن‌ها را به‌روز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden korostaa salasanat, jotka saattavat olla vuotaneita, heikkoja, uudelleen käytettyjä tai käytössä suojaamattomilla verkkosivustoilla, jotta voit päivittää ne nopeasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden met en évidence les mots de passe susceptibles d’être exposés, faibles, réutilisés ou employés sur des sites Web non sécurisés afin que vous puissiez les modifier rapidement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden מדגיש סיסמאות שעשויות להיות חשופות, חלשות, בשימוש חוזר או בשימוש באתרים לא מאובטחים, כדי שתוכלו לעדכן אותן במהירות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden ऐसे पासवर्ड को हाइलाइट करता है जो उजागर, कमजोर, दोबारा उपयोग किए गए या असुरक्षित वेबसाइटों पर उपयोग हो सकते हैं, ताकि आप उन्हें जल्दी अपडेट कर सकें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden ističe lozinke koje su možda procurjele, slabe, ponovno korištene ili korištene na nezaštićenim web-stranicama kako bi ih mogao/la brzo ažurirati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vaultwarden kiemeli a kiszivárgott, gyenge, újrahasznált vagy nem biztonságos webhelyeken használt jelszavakat, hogy gyorsan frissíthesse őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden menyoroti kata sandi yang mungkin terekspos, lemah, digunakan ulang, atau dipakai di situs tidak aman agar Anda dapat segera memperbaruinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden evidenzia le password potenzialmente esposte, deboli, riutilizzate o usate su siti non sicuri, affinché tu possa aggiornarle rapidamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwardenは、漏えい、脆弱、使い回し、安全でないWebサイトでの使用の可能性があるパスワードを強調表示し、すばやく更新できるようにします。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden әшкереленген, әлсіз, қайта қолданылған немесе қауіпсіз емес веб-сайттарда пайдаланылған құпиясөздерді тез жаңартуыңыз үшін белгілейді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden은 노출되었거나 약하거나 재사용되었거나 보안되지 않은 웹사이트에서 사용된 비밀번호를 강조하여 빠르게 변경할 수 있게 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden išryškina galimai nutekintus, silpnus, pakartotinai naudojamus ar nesaugiose svetainėse naudojamus slaptažodžius, kad galėtumėte juos greitai atnaujinti."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden menyerlahkan kata laluan yang mungkin terdedah, lemah, digunakan semula atau digunakan pada laman web tidak selamat supaya anda boleh mengemas kininya dengan cepat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden fremhever passord som kan være eksponert, svake, gjenbrukt eller brukt på usikre nettsteder, slik at du raskt kan oppdatere dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden markeert wachtwoorden die mogelijk zijn gelekt, zwak zijn, opnieuw worden gebruikt of op onbeveiligde websites worden gebruikt, zodat je ze snel kunt bijwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden wskazuje hasła, które mogą być ujawnione, słabe, używane ponownie lub stosowane w niezabezpieczonych witrynach, aby można je było szybko zmienić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Vaultwarden destaca palavras-passe que podem estar expostas, ser fracas, reutilizadas ou usadas em sites não seguros, para que possa atualizá-las rapidamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden evidențiază parolele care pot fi expuse, slabe, reutilizate sau folosite pe site-uri nesecurizate, pentru a le putea actualiza rapid."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden отмечает пароли, которые могут быть раскрыты, слабы, используются повторно или применяются на незащищённых сайтах, чтобы вы могли быстро их обновить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden zvýrazní heslá, ktoré môžu byť odhalené, slabé, opakovane použité alebo používané na nezabezpečených webových stránkach, aby ste ich mohli rýchlo aktualizovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden označi gesla, ki so morda razkrita, šibka, ponovno uporabljena ali uporabljena na nezaščitenih spletnih mestih, da jih lahko hitro posodobite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden markerar lösenord som kan vara exponerade, svaga, återanvända eller användas på osäkra webbplatser så att du snabbt kan uppdatera dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden จะเน้นรหัสผ่านที่อาจถูกเปิดเผย อ่อนแอ ใช้ซ้ำ หรือใช้บนเว็บไซต์ที่ไม่ปลอดภัย เพื่อให้คุณอัปเดตได้อย่างรวดเร็ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden, güncelleyebilmeniz için ifşa edilmiş, zayıf, yeniden kullanılan veya güvenli olmayan web sitelerinde kullanılan parolaları vurgular."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden виділяє паролі, які можуть бути викритими, слабкими, повторно використаними або застосованими на незахищених вебсайтах, щоб ви могли швидко їх оновити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden đánh dấu các mật khẩu có thể bị lộ, yếu, dùng lại hoặc dùng trên trang web không an toàn để bạn có thể cập nhật nhanh chóng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden 会标记可能已泄露、强度较弱、重复使用或用于不安全网站的密码，以便您快速更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden 會標記可能已洩露、強度較弱、重復使用或用於不安全網站的密碼，以便您快速更新。"
          }
        }
      }
    },
