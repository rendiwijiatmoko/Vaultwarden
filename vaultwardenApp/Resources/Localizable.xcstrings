    "%@ was not completed. Try again using biometrics or the device passcode, or unlock with your master password." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تكتمل عملية %@. حاول مجددًا باستخدام المقاييس الحيوية أو رمز دخول الجهاز، أو افتح الخزنة بكلمة المرور الرئيسية."
