          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultwarden সার্ভার এই অ্যাপের সঙ্গে দেওয়া বা পুনর্বিতরণ করা হয় না। অ্যাপটি ব্যবহারকারীর বেছে নেওয়া সার্ভারের সঙ্গে যোগাযোগ করে।"
          }
        },
