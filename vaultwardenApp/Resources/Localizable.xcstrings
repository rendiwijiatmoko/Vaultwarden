    "Require biometrics before unlock, reveal, copy, or fill." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب المقاييس الحيوية قبل الفتح أو الإظهار أو النسخ أو الملء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изискване на биометрични данни преди отключване, показване, копиране или попълване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আনলক, দেখানো, কপি বা পূরণ করার আগে বায়োমেট্রিক্স আবশ্যক করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigeix la biometria abans de desbloquejar, mostrar, copiar o emplenar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžadovat biometrii před odemknutím, zobrazením, zkopírováním nebo vyplněním."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræv biometri før oplåsning, visning, kopiering eller udfyldning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometrie vor dem Entsperren, Anzeigen, Kopieren oder Ausfüllen verlangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαίτηση βιομετρικών στοιχείων πριν από το ξεκλείδωμα, την εμφάνιση, την αντιγραφή ή τη συμπλήρωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require biometrics before unlock, reveal, copy, or fill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigir biometría antes de desbloquear, mostrar, copiar o rellenar."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الزام زیست‌سنجی پیش از باز کردن، نمایش، کپی یا تکمیل."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaadi biometrinen tunnistus ennen lukituksen avaamista, näyttämistä, kopiointia tai täyttämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exiger la biométrie avant le déverrouillage, l’affichage, la copie ou le remplissage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דרישת זיהוי ביומטרי לפני ביטול נעילה, הצגה, העתקה או מילוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनलॉक, दिखाने, कॉपी या भरने से पहले बायोमेट्रिक्स आवश्यक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahtijevaj biometriju prije otključavanja, prikaza, kopiranja ili popunjavanja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biometrikus azonosítás megkövetelése feloldás, megjelenítés, másolás vagy kitöltés előtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajibkan biometrik sebelum membuka, menampilkan, menyalin, atau mengisi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi i dati biometrici prima di sbloccare, mostrare, copiare o compilare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック解除、表示、コピー、入力の前に生体認証を要求します。"
