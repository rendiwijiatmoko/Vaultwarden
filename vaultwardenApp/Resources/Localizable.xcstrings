          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez cette application comme fournisseur d’identifiants afin que les mots de passe et les codes de vérification apparaissent hors du coffre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להפעיל יישום זה כספק אישורים כדי שסיסמאות וקודי אימות יופיעו מחוץ לכספת."
