    "Creates a private, non-identifying username. Email aliases can be added later through a supported alias provider." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ اسم مستخدم خاصًا لا يكشف عن الهوية. يمكن إضافة أسماء بريد إلكتروني مستعارة لاحقًا عبر موفر أسماء مستعارة مدعوم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Създава лично, неидентифициращо потребителско име. Псевдоними за имейл могат да се добавят по-късно чрез поддържан доставчик на псевдоними."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিচয় প্রকাশ না করে এমন একটি ব্যক্তিগত ইউজারনেম তৈরি করে। সমর্থিত অ্যালিয়াস প্রদানকারীর মাধ্যমে পরে ইমেইল অ্যালিয়াস যোগ করা যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nom d'usuari privat que no us identifica. Més endavant podreu afegir àlies de correu mitjançant un proveïdor d'àlies compatible."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoří soukromé uživatelské jméno, které vás neidentifikuje. E-mailové aliasy lze později přidat prostřednictvím podporovaného poskytovatele aliasů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opretter et privat brugernavn, der ikke identificerer dig. E-mailaliasser kan tilføjes senere via en understøttet aliasudbyder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt einen privaten, nicht identifizierenden Benutzernamen. E-Mail-Aliasse können später über einen unterstützten Alias-Anbieter hinzugefügt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργεί ένα ιδιωτικό όνομα χρήστη που δεν σας ταυτοποιεί. Ψευδώνυμα email μπορούν να προστεθούν αργότερα μέσω υποστηριζόμενου παρόχου ψευδωνύμων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a private, non-identifying username. Email aliases can be added later through a supported alias provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nombre de usuario privado que no permite identificarte. Los alias de correo electrónico se pueden añadir más adelante mediante un proveedor de alias compatible."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام کاربری خصوصی و بدون قابلیت شناسایی می‌سازد. نام‌های مستعار ایمیل را می‌توان بعداً از طریق ارائه‌دهنده پشتیبانی‌شده افزود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo yksityisen käyttäjätunnuksen, joka ei paljasta henkilöllisyyttä. Sähköpostialiaksia voi lisätä myöhemmin tuetun aliaspalvelun kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée un nom d’utilisateur privé qui ne permet pas de vous identifier. Des alias d’adresse électronique pourront être ajoutés ultérieurement à l’aide d’un fournisseur d’alias compatible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יוצר שם משתמש פרטי שאינו מזהה אתכם. ניתן להוסיף כינויי דוא״ל מאוחר יותר באמצעות ספק כינויים נתמך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक निजी, पहचान न बताने वाला यूज़रनेम बनाता है। समर्थित उपनाम प्रदाता के माध्यम से ईमेल उपनाम बाद में जोड़े जा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izrađuje privatno korisničko ime koje ne otkriva identitet. Alias e-pošte može se dodati kasnije putem podržanog pružatelja aliasa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privát, azonosításra nem alkalmas felhasználónevet hoz létre. E-mail-aliasok később, támogatott aliasszolgáltatóval adhatók hozzá."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat nama pengguna privat yang tidak mengidentifikasi Anda. Alias email dapat ditambahkan nanti melalui penyedia alias yang didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un nome utente privato e non identificativo. Gli alias email possono essere aggiunti in seguito tramite un provider supportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人を特定しない非公開のユーザー名を作成します。メールエイリアスは、対応するエイリアスプロバイダーを通じて後から追加できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жеке тұлғаны анықтамайтын құпия пайдаланушы атын жасайды. Электрондық пошта бүркеншік аттарын кейін қолдау көрсетілетін провайдер арқылы қосуға болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인을 식별하지 않는 비공개 사용자 이름을 만듭니다. 지원되는 별칭 제공자를 통해 이메일 별칭을 나중에 추가할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sukuria privatų, tapatybės neatskleidžiantį naudotojo vardą. El. pašto pseudonimus vėliau galima pridėti per palaikomą teikėją."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencipta nama pengguna peribadi yang tidak mengenal pasti. Alias e-mel boleh ditambah kemudian melalui penyedia alias disokong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppretter et privat brukernavn som ikke identifiserer deg. E-postaliaser kan legges til senere via en støttet aliasleverandør."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt een persoonlijke, niet-identificerende gebruikersnaam aan. E-mailaliassen kunnen later worden toegevoegd via een ondersteunde aliasprovider."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy prywatną, nieidentyfikującą nazwę użytkownika. Aliasy e-mail można dodać później przez obsługiwanego dostawcę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria um nome de utilizador privado e não identificável. Os aliases de e-mail podem ser adicionados mais tarde através de um fornecedor de aliases compatível."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează un nume de utilizator privat, care nu vă identifică. Aliasurile de e-mail pot fi adăugate ulterior printr-un furnizor de aliasuri compatibil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт приватное имя пользователя, не позволяющее установить личность. Псевдонимы электронной почты можно добавить позже через поддерживаемого поставщика псевдонимов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvorí súkromné, neidentifikujúce používateľské meno. E-mailové aliasy môžete pridať neskôr prostredníctvom podporovaného poskytovateľa aliasov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustvari zasebno uporabniško ime, ki ne razkriva identitete. E-poštne vzdevke lahko pozneje dodate prek podprtega ponudnika vzdevkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skapar ett privat användarnamn som inte kan identifiera dig. E-postalias kan läggas till senare via en aliasleverantör som stöds."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างชื่อผู้ใช้ส่วนตัวที่ไม่ระบุตัวตน คุณสามารถเพิ่มอีเมลแทนภายหลังผ่านผู้ให้บริการอีเมลแทนที่รองรับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel ve kimliğinizi belli etmeyen bir kullanıcı adı oluşturur. E-posta diğer adları daha sonra desteklenen bir diğer ad sağlayıcısıyla eklenebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створює приватне ім'я користувача, що не розкриває особу. Псевдоніми електронної пошти можна додати пізніше через підтримуваного постачальника псевдонімів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo một tên đăng nhập riêng tư, không nhận dạng danh tính. Có thể thêm bí danh email sau thông qua nhà cung cấp bí danh được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建一个不会暴露身份的私密用户名。稍后可以通过支持的别名提供商添加电子邮件别名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立一個不會暴露身分的私密使用者名。稍後可以通過支持的別名提供者添加電子郵件別名。"
          }
        }
      }
    },
