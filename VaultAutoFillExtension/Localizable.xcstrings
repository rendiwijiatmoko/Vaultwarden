    "%lld credentials and %lld passkeys are ready. Finish setup to enable passkey, password, and verification-code suggestions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبحت %lld من بيانات الاعتماد و%lld من مفاتيح المرور جاهزة. أكمل الإعداد لتفعيل اقتراحات مفاتيح المرور وكلمات المرور ورموز التحقق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готови са %lld идентификационни данни и %lld секретни ключа. Завършете настройката, за да включите предложенията за секретни ключове, пароли и кодове за потвърждение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lldটি ক্রেডেনশিয়াল এবং %lldটি পাসকি প্রস্তুত। পাসকি, পাসওয়ার্ড ও যাচাইকরণ কোডের পরামর্শ চালু করতে সেটআপ সম্পন্ন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld credencials i %lld claus de pas estan preparades. Completeu la configuració per activar els suggeriments de claus de pas, contrasenyes i codis de verificació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld přihlašovacích údajů a %lld přístupových klíčů je připraveno. Dokončete nastavení a zapněte návrhy přístupových klíčů, hesel a ověřovacích kódů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld loginoplysninger og %lld adgangsnøgler er klar. Fuldfør opsætningen for at aktivere forslag til adgangsnøgler, adgangskoder og bekræftelseskoder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Zugangsdaten und %lld Passkeys sind bereit. Schließe die Einrichtung ab, um Vorschläge für Passkeys, Passwörter und Bestätigungscodes zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld διαπιστευτήρια και %lld κλειδιά πρόσβασης είναι έτοιμα. Ολοκληρώστε τη ρύθμιση για να ενεργοποιήσετε προτάσεις κλειδιών πρόσβασης, κωδικών και κωδικών επαλήθευσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld credentials and %lld passkeys are ready. Finish setup to enable passkey, password, and verification-code suggestions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld credenciales y %lld claves de acceso están listas. Completa la configuración para activar las sugerencias de claves de acceso, contraseñas y códigos de verificación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld اطلاعات ورود و %lld کلید عبور آماده است. برای فعال کردن پیشنهادهای کلید عبور، کلمه عبور و کد تأیید، راه‌اندازی را کامل کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kirjautumistietoa ja %lld pääsyavainta ovat valmiina. Viimeistele määritys ottaaksesi pääsyavainten, salasanojen ja vahvistuskoodien ehdotukset käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld identifiants et %lld clés d’accès sont prêts. Terminez la configuration pour activer les suggestions de clés d’accès, de mots de passe et de codes de vérification."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld אישורים ו-%lld מפתחות גישה מוכנים. יש לסיים את ההגדרה כדי להפעיל הצעות למפתחות גישה, לסיסמאות ולקודי אימות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld क्रेडेंशियल और %lld पासकी तैयार हैं। पासकी, पासवर्ड और सत्यापन-कोड सुझाव सक्षम करने के लिए सेटअप पूरा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld vjerodajnica i %lld pristupnih ključeva je spremno. Dovrši postavljanje za uključivanje prijedloga pristupnih ključeva, lozinki i kodova za provjeru."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld hitelesítő adat és %lld hozzáférési kulcs kész. Fejezze be a beállítást a hozzáférésikulcs-, jelszó- és ellenőrzőkód-javaslatok engedélyezéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kredensial dan %lld passkey siap. Selesaikan penyiapan untuk mengaktifkan saran passkey, kata sandi, dan kode verifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld credenziali e %lld passkey sono pronte. Completa la configurazione per abilitare i suggerimenti di passkey, password e codici di verifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件の資格情報と%lld件のパスキーを利用できます。設定を完了して、パスキー、パスワード、確認コードの候補を有効にしてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld тіркелгі дерегі және %lld кіру кілті дайын. Кіру кілті, құпиясөз және растау коды ұсыныстарын қосу үшін орнатуды аяқтаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자격 증명 %lld개와 패스키 %lld개가 준비되었습니다. 설정을 완료하여 패스키, 비밀번호 및 인증 코드 제안을 활성화하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paruošta %lld prisijungimo duomenų ir %lld prieigos raktų. Užbaikite sąranką, kad įjungtumėte prieigos raktų, slaptažodžių ir patvirtinimo kodų pasiūlymus."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kelayakan dan %lld kunci laluan sudah sedia. Selesaikan persediaan untuk mendayakan cadangan kunci laluan, kata laluan dan kod pengesahan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld legitimasjoner og %lld passnøkler er klare. Fullfør oppsettet for å aktivere forslag til passnøkler, passord og bekreftelseskoder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld inloggegevens en %lld passkeys zijn gereed. Voltooi de configuratie om suggesties voor passkeys, wachtwoorden en verificatiecodes in te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld danych logowania i %lld kluczy dostępu jest gotowych. Dokończ konfigurację, aby włączyć sugestie kluczy dostępu, haseł i kodów weryfikacyjnych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld credenciais e %lld chaves de acesso estão prontas. Conclua a configuração para ativar sugestões de chaves de acesso, palavras-passe e códigos de verificação."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld date de autentificare și %lld chei de acces sunt pregătite. Finalizați configurarea pentru a activa sugestiile de chei de acces, parole și coduri de verificare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld учётных данных и %lld ключей доступа готовы. Завершите настройку, чтобы включить предложения ключей доступа, паролей и кодов подтверждения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld prihlasovacích údajov a %lld prístupových kľúčov je pripravených. Dokončite nastavenie a povoľte návrhy prístupových kľúčov, hesiel a overovacích kódov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld poverilnic in %lld ključev za dostop je pripravljenih. Dokončajte nastavitev, da omogočite predloge ključev za dostop, gesel in kod za preverjanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld inloggningsuppgifter och %lld nycklar är klara. Slutför konfigurationen för att aktivera förslag på nycklar, lösenord och verifieringskoder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลประจำตัว %lld รายการและพาสคีย์ %lld รายการพร้อมแล้ว ตั้งค่าให้เสร็จเพื่อเปิดใช้คำแนะนำพาสคีย์ รหัสผ่าน และรหัสยืนยัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kimlik bilgisi ve %lld geçiş anahtarı hazır. Geçiş anahtarı, parola ve doğrulama kodu önerilerini etkinleştirmek için kurulumu tamamlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld облікових даних і %lld ключів доступу готові. Завершіть налаштування, щоб увімкнути пропозиції ключів доступу, паролів і кодів підтвердження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld thông tin xác thực và %lld mã khóa đã sẵn sàng. Hoàn tất thiết lập để bật đề xuất mã khóa, mật khẩu và mã xác minh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个凭据和 %lld 个通行密钥已就绪。完成设置即可启用通行密钥、密码和验证码建议。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個登入資訊和 %lld 個密碼金鑰已就緒。完成設定即可啟用密碼金鑰、密碼和驗證碼建議。"
          }
        }
      }
    },
    "A new Login item will be encrypted and saved to your Vaultwarden vault." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تشفير عنصر تسجيل دخول جديد وحفظه في خزنة Vaultwarden الخاصة بك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нов елемент за вход ще бъде шифрован и запазен във Вашия трезор на Vaultwarden."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি নতুন লগইন আইটেম এনক্রিপ্ট করে আপনার Vaultwarden ভল্টে সংরক্ষণ করা হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un element d'inici de sessió nou es xifrarà i es desarà a la caixa forta de Vaultwarden."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nová přihlašovací položka bude zašifrována a uložena do vašeho trezoru Vaultwarden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et nyt login-element krypteres og gemmes i din Vaultwarden-boks."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Zugang wird verschlüsselt und in deinem Vaultwarden-Tresor gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα νέο στοιχείο σύνδεσης θα κρυπτογραφηθεί και θα αποθηκευτεί στην κρύπτη Vaultwarden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new Login item will be encrypted and saved to your Vaultwarden vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuevo elemento de inicio de sesión se cifrará y guardará en tu caja fuerte de Vaultwarden."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک مورد ورود جدید رمزگذاری و در گاوصندوق Vaultwarden ذخیره می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusi kirjautumiskohde salataan ja tallennetaan Vaultwarden-holviisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouvel élément d’identification sera chiffré et enregistré dans votre coffre Vaultwarden."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פריט התחברות חדש יוצפן ויישמר בכספת Vaultwarden שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक नया लॉगिन आइटम एन्क्रिप्ट होकर आपकी Vaultwarden तिजोरी में सहेजा जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova stavka za prijavu bit će šifrirana i spremljena u tvoj Vaultwarden trezor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy új bejelentkezési elem titkosítva lesz, és a Vaultwarden-széfbe kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item Login baru akan dienkripsi dan disimpan ke brankas Vaultwarden Anda."
          }
        },
        "it" : {
