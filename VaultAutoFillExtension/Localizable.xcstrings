        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε το διαπιστευτήριο πριν το αποθηκεύσετε στην κρυπτογραφημένη κρύπτη Vaultwarden."
          }
        },
        "en" : {
          "stringUnit" : {
