        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش از ذخیره اطلاعات ورود در گاوصندوق رمزگذاری‌شده Vaultwarden، آن را بررسی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista kirjautumistiedot ennen niiden tallentamista salattuun Vaultwarden-holviisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les identifiants avant de les enregistrer dans votre coffre Vaultwarden chiffré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבדוק את האישור לפני שמירתו בכספת Vaultwarden המוצפנת שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रेडेंशियल को अपनी एन्क्रिप्टेड Vaultwarden तिजोरी में सहेजने से पहले उसकी समीक्षा करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
