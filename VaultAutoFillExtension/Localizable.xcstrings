    "Your session expired. Open Vaultwarden and sync before creating a password." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية جلستك. افتح Vaultwarden وأجرِ المزامنة قبل إنشاء كلمة مرور."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сесията Ви изтече. Отворете Vaultwarden и синхронизирайте, преди да създадете парола."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সেশনের মেয়াদ শেষ হয়েছে। পাসওয়ার্ড তৈরির আগে Vaultwarden খুলে সিঙ্ক করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessió ha caducat. Obriu Vaultwarden i sincronitzeu abans de crear una contrasenya."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnost relace vypršela. Před vytvořením hesla otevřete Vaultwarden a synchronizujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din session er udløbet. Åbn Vaultwarden, og synkroniser, før du opretter en adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
