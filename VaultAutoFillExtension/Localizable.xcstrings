    "Review the credential before saving it to your encrypted Vaultwarden vault." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع بيانات الاعتماد قبل حفظها في خزنة Vaultwarden المشفرة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прегледайте идентификационните данни, преди да ги запазите в шифрования си трезор на Vaultwarden."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এনক্রিপ্ট করা Vaultwarden ভল্টে সংরক্ষণের আগে ক্রেডেনশিয়ালটি পর্যালোচনা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reviseu la credencial abans de desar-la a la caixa forta xifrada de Vaultwarden."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Před uložením do šifrovaného trezoru Vaultwarden přihlašovací údaje zkontrolujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemgå loginoplysningerne, før de gemmes i din krypterede Vaultwarden-boks."
